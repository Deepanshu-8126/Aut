      }
    },
    {
      "id": 2,
      "heading": "Two pointers in an array",
      "narration": "Put one pointer at the left end and one at the right end. Check the sum, then move the pointer that helps.",
      "remotion": {
        "type": "ArrayViz",
        "props": {
          "title": "Sorted array: target 9",
          "values": [
            1,
            3,
            4,
            6,
            8,
            11
          ],
          "steps": [
            {
              "at": "left",
              "label": "Left = 1, right = 11. Sum 12, bahut bada.",
              "pointers": {
                "L": 0,
                "R": 5
              },
              "compare": [
                0,
                5
              ]
            },
            {
              "at": "Check",
              "label": "Sum 12 > 9, isliye right ko left karo.",
              "pointers": {
                "L": 0,
                "R": 4
              },
              "compare": [
                0,
                4
              ]
            },
            {
              "at": "move",
              "label": "Sum 9 mil gaya! Answer mila.",
              "pointers": {
                "L": 1,
                "R": 3
              },
              "highlight": [
                1,
                3
              ]
            }
          ]
        }
      }
    },
