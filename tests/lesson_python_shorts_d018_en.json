    {
      "id": 3,
      "narration": "Here, enumerate gives us the index. Then, zip combines names and scores. This keeps your code clean and avoids those annoying index out of range errors.",
      "remotion": {
        "type": "TypingCode",
        "type_anchor": "Here",
        "keyIdea": "Clean code, no manual counters",
        "props": {
          "filename": "loops.py",
          "language": "python",
          "code": "names = ['Alice', 'Bob']\nscores = [85, 92]\n\n# Using Enumerate\nfor i, name in enumerate(names):\n    print(f'{i}: {name}')\n\n# Using Zip\nfor name, score in zip(names, scores):\n    print(f'{name} got {score}')",
          "highlightLines": [
            4,
            8
          ]
        },
        "popups": [
