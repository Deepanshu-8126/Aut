    },
    {
      "id": 4,
      "narration": "Why do we need this? Imagine storing a long sentence letter by letter. It would be impossible to manage. Strings let us handle the whole sentence as one single unit.",
      "remotion": {
        "type": "SummaryList",
        "props": {
          "title": "Why use Strings?",
          "items": [
            "Store names and addresses",
            "Handle user input easily",
            "Manage long paragraphs of text",
            "Perform actions like searching or joining"
          ]
        }
      }
    },
    {
      "id": 5,
      "narration": "Here is the map of a String variable. We have the type, the variable name, and the literal text. A literal is just the actual text inside the double quotes.",
      "remotion": {
        "type": "DiagramFlow",
        "props": {
          "title": "String Structure",
          "nodes": [
            {
              "id": "type",
