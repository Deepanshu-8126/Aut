  "scenes": [
    {
      "id": 1,
      "narration": "Welcome to Day 7. Today we are learning about Strings. In Java, a String is how we store and work with text like names, messages, or even long sentences.",
      "remotion": {
        "type": "TitleCard",
        "props": {
          "title": "Java Strings",
          "subtitle": "Handling Text in Java",
          "badge": "DAY 7 • JAVA BASICS",
          "tags": [
            "Java",
            "Strings",
            "Programming"
          ]
        },
        "chapter": "M1 Setup and Basics"
      }
    },
    {
      "id": 2,
      "narration": "Imagine you are building a login screen. You need to save the user's name. A single letter is a character, but a full name is a sequence called a String.",
      "remotion": {
        "type": "ArchitectureFlow",
        "props": {
          "title": "What is a String?",
          "steps": [
            {
              "title": "Character",
              "desc": "A single letter like 'A' or 'B'."
            },
            {
              "title": "String",
              "desc": "A sequence of characters like 'Alice'."
            }
          ],
          "activeStepIndex": 1
        },
        "keyIdea": "A String is a sequence of characters"
      }
    },
    {
      "id": 3,
      "narration": "Think of a String like a beaded necklace. Each bead is one character. When you put them on a thread, they form a single piece of text that we can use.",
      "remotion": {
