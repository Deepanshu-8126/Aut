              "label": "Computer RAM"
            }
          ],
          "edges": [
            {
              "from": "small",
              "to": "mem",
              "label": "Uses 4 bytes"
            },
            {
              "from": "large",
              "to": "mem",
              "label": "Uses 8 bytes"
            }
          ],
          "steps": [
            {
