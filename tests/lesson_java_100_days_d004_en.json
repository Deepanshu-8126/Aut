  "scenes": [
    {
      "id": 1,
      "narration": "Imagine you are moving into a new house. You have different boxes for different items. You use small boxes for jewelry and huge boxes for books. In Java, these boxes are called data types.",
      "remotion": {
        "type": "TitleCard",
        "props": {
          "title": "Java Primitive Data Types",
          "subtitle": "Choosing the right box for your data",
          "badge": "DAY 4 • JAVA BASICS",
