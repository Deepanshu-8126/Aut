          },
          {
            "anchor": "Bob",
            "text": "Overrides with 'Hi'",
            "kind": "tip"
          }
        ],
        "keyIdea": "Keyword arguments use the name"
      }
    },
    {
      "id": 4,
      "narration": "Alice gets the default Hello, but Bob gets the custom message. This flexibility is why Python is so popular. Try adding a default value to your next function!",
