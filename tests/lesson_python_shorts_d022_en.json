    {
      "id": 3,
      "narration": "Here, the message defaults to Hello. When we call greet for Alice, it uses that default. For Bob, we use a keyword to change the message specifically.",
      "remotion": {
        "type": "TypingCode",
        "type_anchor": "Here",
        "props": {
          "filename": "greet.py",
          "language": "python",
          "code": "def greet(name, msg=\"Hello\"):\n    print(f\"{msg}, {name}!\")\n\ngreet(\"Alice\")\ngreet(\"Bob\", msg=\"Hi\")",
          "highlightLines": [
            1,
            4,
            5
          ]
        },
        "camera": [
          {
            "at": "Hello",
            "zoom": 1.7,
            "x": 60,
            "y": 25
          },
